# Copy this file to .env.private-development.local for a local process run.
# The local file is ignored by Git. Keep SSH credentials in ~/.ssh or an
# external credential store rather than in the application environment.
CLAUDIAN_CLOUD_DEPLOYMENT_PROFILE=private-development
CLAUDIAN_CLOUD_BIND_HOST=127.0.0.1
CLAUDIAN_CLOUD_PORT=8787
CLAUDIAN_CLOUD_SHUTDOWN_TIMEOUT_MS=15000
