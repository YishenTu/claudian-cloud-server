# Copy this file to an operator-owned path outside the repository.
# Keep deployment credentials in an external credential store.
CLAUDIAN_CLOUD_BIND_HOST=127.0.0.1
CLAUDIAN_CLOUD_PRINCIPAL_PROFILE=trusted-ingress
# Select any unused TCP port on the deployment host.
CLAUDIAN_CLOUD_PORT=8787
CLAUDIAN_CLOUD_POSTGRES_URL=postgresql://claudian_cloud_runtime:replace-with-runtime-secret@127.0.0.1:5432/claudian_cloud
CLAUDIAN_CLOUD_STORAGE_NODE_ID=local-node
CLAUDIAN_CLOUD_REPOSITORY_ROOT=/var/lib/claudian-cloud/repositories
CLAUDIAN_CLOUD_STAGING_ROOT=/var/lib/claudian-cloud/staging
CLAUDIAN_CLOUD_GIT_EXECUTABLE=/usr/bin/git

# Production ingress accepts identity only from an operator-controlled PROXY v2
# listener. Each principal ID must be the stable Claudian installation key for
# the authenticated device at that Tailnet address; replace every example.
CLAUDIAN_CLOUD_TRUSTED_INGRESS_MODE=proxy-v2
CLAUDIAN_CLOUD_TRUSTED_INGRESS_PROVIDER_ID=tailscale-serve
CLAUDIAN_CLOUD_TRUSTED_INGRESS_SOURCE_MAP=[{"deviceCredentialId":"mac-a","principalId":"installation-key-a","sourceAddress":"100.64.0.10"},{"deviceCredentialId":"mac-b","principalId":"installation-key-b","sourceAddress":"100.64.0.11"}]

# Optional A-test safety limits. Omit these fields to use the shown defaults.
CLAUDIAN_CLOUD_POSTGRES_ORDINARY_POOL_MAX=8
CLAUDIAN_CLOUD_POSTGRES_PINNED_POOL_MAX=2
CLAUDIAN_CLOUD_POSTGRES_RESERVED_POOL_MAX=2
CLAUDIAN_CLOUD_PROJECT_LOCK_TIMEOUT_MS=2000
CLAUDIAN_CLOUD_EVENT_MAX_CONNECTIONS=64
CLAUDIAN_CLOUD_EVENT_MAX_CONNECTIONS_PER_PROJECT=16
CLAUDIAN_CLOUD_EVENT_MAX_PENDING_AUTHORIZATIONS=16
CLAUDIAN_CLOUD_GIT_MAX_CHILDREN=2
CLAUDIAN_CLOUD_GIT_MAX_CHILDREN_PER_PROJECT=1
CLAUDIAN_CLOUD_GIT_MAX_READ_CHILDREN=1
CLAUDIAN_CLOUD_GIT_MAX_WRITE_CHILDREN=1
CLAUDIAN_CLOUD_GIT_QUEUE_MAX=6
CLAUDIAN_CLOUD_GIT_QUEUE_MAX_PER_PROJECT=4
CLAUDIAN_CLOUD_GIT_MAX_QUEUED_READS=5
CLAUDIAN_CLOUD_GIT_MAX_QUEUED_WRITES=5
CLAUDIAN_CLOUD_GIT_QUEUE_TIMEOUT_MS=10000
CLAUDIAN_CLOUD_GIT_OPERATION_TIMEOUT_MS=300000
CLAUDIAN_CLOUD_GIT_OUTPUT_MAX_BYTES=1048576
CLAUDIAN_CLOUD_BOOTSTRAP_ATTEMPT_TTL_MS=86400000
CLAUDIAN_CLOUD_BOOTSTRAP_MAX_BUNDLE_BYTES=1073741824
CLAUDIAN_CLOUD_BOOTSTRAP_MAX_REPOSITORY_BYTES=1073741824
CLAUDIAN_CLOUD_BOOTSTRAP_QUEUE_MAX=4
CLAUDIAN_CLOUD_BOOTSTRAP_QUEUE_TIMEOUT_MS=10000
CLAUDIAN_CLOUD_BOOTSTRAP_STAGING_FREE_SPACE_FLOOR_BYTES=1073741824
CLAUDIAN_CLOUD_BOOTSTRAP_STAGING_RESERVATION_BYTES=2147483648
CLAUDIAN_CLOUD_BOOTSTRAP_UPLOAD_DEADLINE_MS=900000
CLAUDIAN_CLOUD_BOOTSTRAP_UPLOAD_IDLE_TIMEOUT_MS=30000
