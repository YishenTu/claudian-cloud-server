# Copy this file to an operator-owned path outside the repository.
# Keep deployment credentials in an external credential store.
CLAUDIAN_CLOUD_BIND_HOST=127.0.0.1
# Select any unused TCP port on the deployment host.
CLAUDIAN_CLOUD_PORT=8787
CLAUDIAN_CLOUD_POSTGRES_URL=postgresql://claudian_cloud_runtime:replace-me@127.0.0.1:5432/claudian_cloud
CLAUDIAN_CLOUD_STORAGE_NODE_ID=local-node
CLAUDIAN_CLOUD_REPOSITORY_ROOT=/var/lib/claudian-cloud/repositories
CLAUDIAN_CLOUD_GIT_EXECUTABLE=/usr/bin/git

# Optional A-test safety limits. Omit these fields to use the shown defaults.
CLAUDIAN_CLOUD_POSTGRES_ORDINARY_POOL_MAX=8
CLAUDIAN_CLOUD_POSTGRES_PINNED_POOL_MAX=2
CLAUDIAN_CLOUD_POSTGRES_RESERVED_POOL_MAX=2
CLAUDIAN_CLOUD_PROJECT_LOCK_TIMEOUT_MS=2000
CLAUDIAN_CLOUD_GIT_MAX_CHILDREN=2
CLAUDIAN_CLOUD_GIT_MAX_CHILDREN_PER_PROJECT=1
CLAUDIAN_CLOUD_GIT_QUEUE_MAX=6
CLAUDIAN_CLOUD_GIT_QUEUE_MAX_PER_PROJECT=4
CLAUDIAN_CLOUD_GIT_QUEUE_TIMEOUT_MS=10000
CLAUDIAN_CLOUD_GIT_OPERATION_TIMEOUT_MS=300000
CLAUDIAN_CLOUD_GIT_OUTPUT_MAX_BYTES=1048576
