# Use this file only with the bootstrap-role one-shot service.
# Keep all provisioning credentials in an external credential store.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=claudian_cloud_bootstrap
PGPASSWORD=replace-with-bootstrap-secret
PGDATABASE=postgres
CLAUDIAN_CLOUD_POSTGRES_MIGRATION_PASSWORD=replace-with-migration-secret
CLAUDIAN_CLOUD_POSTGRES_RUNTIME_PASSWORD=replace-with-runtime-secret
