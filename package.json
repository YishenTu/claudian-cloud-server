{
  "name": "@claudian/cloud-server",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical Cloud authority for Claudian Collab",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && tsx scripts/copy-runtime-assets.ts",
    "check:deployment": "CLAUDIAN_CLOUD_ENV_FILE=\"$PWD/.env.example\" CLAUDIAN_CLOUD_POSTGRES_ENV_FILE=\"$PWD/.env.postgres.example\" CLAUDIAN_CLOUD_BOOTSTRAP_ENV_FILE=\"$PWD/.env.bootstrap.example\" CLAUDIAN_CLOUD_MIGRATION_ENV_FILE=\"$PWD/.env.migration.example\" docker compose -f deploy/compose.yaml --profile '*' config --quiet",
    "check:runtime": "tsx scripts/check-runtime.ts",
    "clean": "rm -rf dist",
    "dev": "tsx src/main.ts",
    "lint": "eslint .",
    "migrate": "node dist/migrate.js",
    "prebuild": "npm run check:runtime",
    "predev": "npm run check:runtime",
    "prelint": "npm run check:runtime",
    "prestart": "npm run check:runtime",
    "pretest": "npm run check:runtime",
    "pretypecheck": "npm run check:runtime",
    "start": "node dist/main.js",
    "test": "npm run test:contract && npm run test:application && npm run test:postgres && npm run test:git && npm run test:deployment",
    "test:application": "node --import tsx --test \"tests/config/**/*.test.ts\" \"tests/coordination/**/*.test.ts\" \"tests/integration/http/ApplicationLifecycle.test.ts\" \"tests/integration/http/DevelopmentBootstrapRoutes.test.ts\" \"tests/integration/http/ProjectEventRoutes.test.ts\" \"tests/integration/process/**/*.test.ts\" \"tests/observability/**/*.test.ts\" \"tests/onboarding/**/*.test.ts\" \"tests/project-authority/**/*.test.ts\" \"tests/request-context/**/*.test.ts\" \"tests/resource-admission/**/*.test.ts\" \"tests/server/**/*.test.ts\"",
    "test:contract": "node --import tsx --test \"tests/contract/**/*.test.ts\"",
    "test:deployment": "node --import tsx --test \"tests/deployment/**/*.test.ts\"",
    "test:git": "node --import tsx --test --test-concurrency=1 \"tests/integration/git/**/*.test.ts\"",
    "test:postgres": "node --import tsx --test --test-concurrency=1 \"tests/fault-injection/**/*.test.ts\" \"tests/integration/http/AcceptRecoveryGate.test.ts\" \"tests/integration/http/CollaborationOperationGate.test.ts\" \"tests/integration/http/DevelopmentBootstrapGate.test.ts\" \"tests/integration/http/LocalMilestoneServerGate.test.ts\" \"tests/integration/postgres/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run verify:fast && npm run verify:postgres && npm run verify:git",
    "verify:application": "npm run lint && npm run typecheck && npm run test:application && npm run build",
    "verify:deployment": "npm run check:deployment && docker build --file deploy/Dockerfile --tag claudian-cloud-server:local . && tsx scripts/verify-runtime-image.ts",
    "verify:fast": "npm run lint && npm run typecheck && npm run test:contract && npm run test:application && npm run test:deployment && npm run build",
    "verify:git": "npm run test:git",
    "verify:postgres": "npm run test:postgres"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "eslint": "10.2.0",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.0"
  },
  "dependencies": {
    "@claudian/collab-protocol": "file:vendor/claudian-collab-protocol-0.4.0.tgz",
    "pg": "8.23.0",
    "ws": "8.21.3"
  }
}
